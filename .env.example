# Copy to .env and adjust. setup.sh loads it automatically.
# All values below are the defaults; only set what you need to change.

# 01-user
NEW_USER=agent
NEW_USER_SHELL=/bin/bash
NEW_USER_SUDO=true
SUDO_NOPASSWD=true
COPY_ROOT_KEYS=true
# AUTHORIZED_KEY=ssh-ed25519 AAAA... comment
# AUTHORIZED_KEYS_FILE=/root/extra_keys
# USER_PASSWORD=

# 02-ssh-only
SSH_PERMIT_ROOT=prohibit-password
SSH_PASSWORD_AUTH=no
SSH_ALLOW_NO_KEYS=false

# 03-termius (snap or deb)
TERMIUS_METHOD=snap
TERMIUS_SNAP_CHANNEL=stable
# TERMIUS_DEB_URL=https://www.termius.com/download/linux/Termius.deb

# 04-mosh
MOSH_UDP_RANGE=60000:61000

# 06-vnc (TigerVNC, display :1 = port 5901)
# VNC_USER defaults to NEW_USER
# VNC_USER=agent
VNC_DISPLAY=1
VNC_GEOMETRY=1920x1080
VNC_DEPTH=24
# VNC_PASSWORD=change-me-and-rerun
VNC_UPDATE_PASSWORD=false
VNC_LOCALHOST=no
VNC_FORCE_XSTARTUP=false

# 07-rust
# RUST_USER defaults to NEW_USER
# RUST_USER=agent
RUSTUP_TOOLCHAIN=stable
RUSTUP_PROFILE=default
RUSTUP_UPDATE_ON_RERUN=false
INSTALL_RUST_FOR_ROOT=false

# 08-tailscale (ephemeral reusable auth key recommended)
# TAILSCALE_AUTH_KEY=tskey-auth-...
# TAILSCALE_HOSTNAME=my-vps
# TAILSCALE_EXTRA_ARGS=
TAILSCALE_ENABLE_SSH=true
TAILSCALE_FORCE_UP=false

# 09-zsh
# ZSH_USER defaults to NEW_USER
# ZSH_USER=agent
ZSH_SET_FOR_ROOT=false
ZSH_CREATE_MINIMAL_ZSHRC=true

# 10-docker
# DOCKER_USER defaults to NEW_USER
# DOCKER_USER=agent
DOCKER_ADD_USER_TO_GROUP=true
