# Copy to .env and adjust. setup.sh loads it automatically.
# All values below are the defaults; only set what you need to change.

# 00-dns-fix (quote space-separated lists)
DNS_SERVERS="1.1.1.1 8.8.8.8"
DNS_TEST_HOSTS="archive.ubuntu.com github.com"
DNS_FORCE=false

# 00-prep
PREP_PACKAGES="git curl wget ca-certificates gnupg lsb-release sudo openssh-server software-properties-common unzip ufw dnsutils htop vim"
# PREP_EXTRA_PACKAGES=
PREP_UPGRADE=true

# 01-user (NEW_USER defaults to the sudo-invoking user, else "agent")
# NEW_USER=agent
NEW_USER_SHELL=/bin/bash
NEW_USER_SUDO=true
SUDO_NOPASSWD=true
COPY_ROOT_KEYS=true
# AUTHORIZED_KEY=ssh-ed25519 AAAA... comment
# AUTHORIZED_KEYS_FILE=/root/extra_keys
# USER_PASSWORD=

# 02-ssh-only
SSH_PERMIT_ROOT=prohibit-password
SSH_PASSWORD_AUTH=no
SSH_ALLOW_NO_KEYS=false

# 04-mosh
MOSH_UDP_RANGE=60000:61000

# 06-vnc (TigerVNC, display :1 = port 5901)
# VNC_USER defaults to NEW_USER
# VNC_USER=agent
VNC_DISPLAY=1
VNC_GEOMETRY=1920x1080
VNC_DEPTH=24
# VNC_PASSWORD=change-me-and-rerun
VNC_UPDATE_PASSWORD=false
VNC_LOCALHOST=no
VNC_FORCE_XSTARTUP=false

# 07-rust
# RUST_USER defaults to NEW_USER
# RUST_USER=agent
RUSTUP_TOOLCHAIN=stable
RUSTUP_PROFILE=default
RUSTUP_UPDATE_ON_RERUN=false
INSTALL_RUST_FOR_ROOT=false

# 08-tailscale (ephemeral reusable auth key recommended)
# TAILSCALE_AUTH_KEY=tskey-auth-...
# TAILSCALE_HOSTNAME=my-vps
# TAILSCALE_EXTRA_ARGS=
TAILSCALE_ENABLE_SSH=true
TAILSCALE_FORCE_UP=false

# 09-zsh
# ZSH_USER defaults to NEW_USER
# ZSH_USER=agent
ZSH_SET_FOR_ROOT=false
ZSH_CREATE_MINIMAL_ZSHRC=true
ZSH_INSTALL_OHMYZSH=true
ZSH_OHMYZSH_THEME=robbyrussell
# quote if multiple: ZSH_OHMYZSH_PLUGINS="git docker"
ZSH_OHMYZSH_PLUGINS=git

# 10-docker
# DOCKER_USER defaults to NEW_USER
# DOCKER_USER=agent
DOCKER_ADD_USER_TO_GROUP=true

# 11-lockdown (tailnet-only firewall; off by default)
LOCKDOWN_ENABLE=false
LOCKDOWN_ALLOW_SSH_PUBLIC=false
# LOCKDOWN_PUBLIC_TCP_PORTS="80,443"

# 13-notify (ntfy "agent waiting" phone pings; skipped unless NTFY_TOPIC is set)
# Use a hard-to-guess topic: anyone who knows it can read/push to it.
# NTFY_TOPIC=my-agents-Ab3x9q
NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
# NTFY_USER=
# NTFY_PASSWORD=
# NOTIFY_USER defaults to NEW_USER
# NOTIFY_USER=agent
# NOTIFY_TOOLS=all
# NOTIFY_TOOLS=claude,codex,tmux

# 12-nvm
# NVM_USER defaults to NEW_USER
# NVM_USER=agent
NVM_VERSION=latest
NVM_NODE_VERSION=lts/*
NVM_REINSTALL=false

# 14-opencode
# OPENCODE_USER defaults to NEW_USER
# OPENCODE_USER=agent
# OPENCODE_VERSION=
OPENCODE_UPDATE_ON_RERUN=false

# 15-pi (needs node from 12-nvm.sh)
# PI_USER defaults to NEW_USER
# PI_USER=agent
PI_UPDATE_ON_RERUN=false

# 16-gh (set GH_TOKEN to a PAT with repo access)
# GH_USER defaults to NEW_USER
# GH_USER=agent
# GH_TOKEN=github_pat_...
GH_FORCE_AUTH=false
GH_SETUP_GIT=true
